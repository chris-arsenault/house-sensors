# Placeholders so `docker compose config` resolves locally.
#
# No secret appears here or in the deployed environment. Each container reads
# its own values from SSM at start, with the identity the trust appliance
# issued it, and the paths it reads are declared in compose.yaml beside the
# service (ahara-trust ADR-0002). What a deploy still supplies is the image tag
# and the public Roles Anywhere identifiers below.
IMAGE_TAG=local
COLLECTOR_URL=http://192.168.30.2:8850

AWS_RA_RAW_ARCHIVE_WORKLOAD_ID=spiffe://ahara/house-sensors/raw-archive
AWS_RA_RAW_ARCHIVE_ENROLLMENT_URL=https://example.invalid
AWS_RA_RAW_ARCHIVE_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:trust-anchor/local
AWS_RA_RAW_ARCHIVE_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:profile/local
AWS_RA_RAW_ARCHIVE_ENTRY_ROLE_ARN=arn:aws:iam::000000000000:role/local-entry
AWS_RA_RAW_ARCHIVE_ROLE_ARN=arn:aws:iam::000000000000:role/ahara-machine-house-sensors-raw-archive

AWS_RA_ENVIRONMENT_SENSORS_WORKLOAD_ID=spiffe://ahara/house-sensors/environment-sensors
AWS_RA_ENVIRONMENT_SENSORS_ENROLLMENT_URL=https://example.invalid
AWS_RA_ENVIRONMENT_SENSORS_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:trust-anchor/local
AWS_RA_ENVIRONMENT_SENSORS_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:profile/local
AWS_RA_ENVIRONMENT_SENSORS_ENTRY_ROLE_ARN=arn:aws:iam::000000000000:role/local-entry
AWS_RA_ENVIRONMENT_SENSORS_ROLE_ARN=arn:aws:iam::000000000000:role/ahara-machine-house-sensors-environment-sensors

AWS_RA_VOLT_WORKLOAD_ID=spiffe://ahara/house-sensors/volt
AWS_RA_VOLT_ENROLLMENT_URL=https://example.invalid
AWS_RA_VOLT_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:trust-anchor/local
AWS_RA_VOLT_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:profile/local
AWS_RA_VOLT_ENTRY_ROLE_ARN=arn:aws:iam::000000000000:role/local-entry
AWS_RA_VOLT_ROLE_ARN=arn:aws:iam::000000000000:role/ahara-machine-house-sensors-volt

AWS_RA_VOLT_EVENT_WORKLOAD_ID=spiffe://ahara/house-sensors/volt-event
AWS_RA_VOLT_EVENT_ENROLLMENT_URL=https://example.invalid
AWS_RA_VOLT_EVENT_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:trust-anchor/local
AWS_RA_VOLT_EVENT_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:profile/local
AWS_RA_VOLT_EVENT_ENTRY_ROLE_ARN=arn:aws:iam::000000000000:role/local-entry
AWS_RA_VOLT_EVENT_ROLE_ARN=arn:aws:iam::000000000000:role/ahara-machine-house-sensors-volt-event

AWS_RA_DOWNSAMPLING_WORKLOAD_ID=spiffe://ahara/house-sensors/downsampling
AWS_RA_DOWNSAMPLING_ENROLLMENT_URL=https://example.invalid
AWS_RA_DOWNSAMPLING_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:trust-anchor/local
AWS_RA_DOWNSAMPLING_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:profile/local
AWS_RA_DOWNSAMPLING_ENTRY_ROLE_ARN=arn:aws:iam::000000000000:role/local-entry
AWS_RA_DOWNSAMPLING_ROLE_ARN=arn:aws:iam::000000000000:role/ahara-machine-house-sensors-downsampling
